dist/
# Anchor to repo root: only ignore PyInstaller's root build/ dir.
# (desktop/build/ is governed by the negated rules below so its committed
#  installer assets stay trackable.)
/build/
build-resources/
*.egg-info/
work/
hs_err_pid*.log
replay_pid*.log

# 打包产物与本地脚本不纳入版本控制；跨平台打包配置(yml/spec/entry)已纳入
build-log.txt
desktop/build-log.txt
desktop/dist-electron/
# desktop/build/ holds committed installer assets (icon + custom NSIS wizard).
# Ignore generated intermediates but keep the source assets needed by CI.
desktop/build/*
!desktop/build/icon.ico
!desktop/build/icon.png
!desktop/build/installer/
desktop/out/
website/
*.tsbuildinfo

# 官方介绍网站（无需上传 GitHub，本地独立部署）
website/node_modules/
website/dist/
website/.vite/

# third_party 构建缓存
third_party/audiveris/.gradle/
third_party/audiveris/app/.gradle/
third_party/audiveris/app/bin/
third_party/audiveris/app/build/
third_party/audiveris/build/

