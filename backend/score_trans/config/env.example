# Score Trans 环境配置
# 将此文件复制为 .env 并填入实际值

# === API 基本配置 ===
SCORE_TRANS_API_TITLE=Score Trans
SCORE_TRANS_API_VERSION=0.1.0
SCORE_TRANS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null

# === OCR 视觉识别 ===
SCORE_TRANS_OCR_PROVIDER=siliconflow_deepseek_ocr
SCORE_TRANS_OCR_PROVIDER_PROFILES='[{"id":"siliconflow_deepseek_ocr","label":"硅基流动 DeepSeek-OCR","provider":"openai_compatible","base_url":"https://api.siliconflow.cn/v1","model":"deepseek-ai/DeepSeek-OCR","fallback_model":"Qwen/Qwen3-VL-8B-Instruct","description":"默认 OCR 识别；结果为空时回退到 Qwen3-VL-8B。"}]'
SCORE_TRANS_OCR_BASE_URL=https://api.siliconflow.cn/v1
SCORE_TRANS_OCR_MODEL=deepseek-ai/DeepSeek-OCR
SCORE_TRANS_OCR_FALLBACK_MODEL=Qwen/Qwen3-VL-8B-Instruct
SCORE_TRANS_OCR_API_KEY=sk-your-siliconflow-key
SCORE_TRANS_OCR_TIMEOUT=60
SCORE_TRANS_OCR_MAX_TOKENS=4096
SCORE_TRANS_OCR_TEMPERATURE=0.1

# === AI 简谱转录（视觉 LLM） ===
SCORE_TRANS_AI_PROVIDER=xiaomi_mimo_v25
SCORE_TRANS_AI_PROVIDER_PROFILES='[{"id":"xiaomi_mimo_v25","label":"小米 MiMo-V2.5","provider":"xiaomi_mimo","base_url":"https://api.xiaomimimo.com/v1","model":"mimo-v2.5","description":"MiMo 全模态视觉转写。"}]'
SCORE_TRANS_AI_BASE_URL=https://api.xiaomimimo.com/v1
SCORE_TRANS_AI_MODEL=mimo-v2.5
SCORE_TRANS_AI_API_KEY=sk-your-vision-llm-key
SCORE_TRANS_AI_TIMEOUT=120
SCORE_TRANS_AI_TEMPERATURE=0.3

# === 工作台 AI 助手（百炼 OpenAI 兼容模式） ===
SCORE_TRANS_ASSISTANT_PROVIDER=dashscope_deepseek_v4_flash
SCORE_TRANS_ASSISTANT_PROVIDER_PROFILES='[{"id":"dashscope_deepseek_v4_flash","label":"百炼 DeepSeek-V4-Flash","provider":"dashscope","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"deepseek-v4-flash","description":"默认工作台对话模型。"}]'
SCORE_TRANS_ASSISTANT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SCORE_TRANS_ASSISTANT_MODEL=deepseek-v4-flash
SCORE_TRANS_ASSISTANT_API_KEY=sk-your-bailian-key

# === PDF ===
SCORE_TRANS_PDF_RENDER_DPI=300
SCORE_TRANS_UPLOAD_PDF_DPI=300

# === Audiveris / Java OMR ===
# 可选：限制或强制 Audiveris 处理步骤。可用步骤：
# LOAD, BINARY, SCALE, GRID, HEADERS, STEM_SEEDS, BEAMS, LEDGERS, HEADS, STEMS,
# REDUCTION, CUE_BEAMS, TEXTS, MEASURES, CHORDS, CURVES, SYMBOLS, LINKS, RHYTHMS, PAGE
SCORE_TRANS_AUDIVERIS_STEP=
SCORE_TRANS_AUDIVERIS_FORCE=0
SCORE_TRANS_AUDIVERIS_SAVE=0
SCORE_TRANS_AUDIVERIS_SWAP=0
SCORE_TRANS_AUDIVERIS_TRANSCRIBE=0
SCORE_TRANS_AUDIVERIS_SHEETS=
# 用分号分隔多个 Audiveris -constant key=value
SCORE_TRANS_AUDIVERIS_CONSTANTS=
# 高级兜底：直接追加 Audiveris CLI 参数，例如：-run some.Class
SCORE_TRANS_AUDIVERIS_EXTRA_ARGS=
# Audiveris JVM 最大堆内存，可选：1g / 2g / 3g / 4g（默认 2g）
# 21MP 高分辨率曲谱约需 1-2g；启动时若内存溢出崩溃，调小此值
SCORE_TRANS_AUDIVERIS_MAX_HEAP=2g

# === Render 渲染 ===
SCORE_TRANS_RENDER_CHORD_GAP=38
SCORE_TRANS_RENDER_OCTAVE_DOT_OFFSET=4
SCORE_TRANS_RENDER_OCTAVE_DOT_GAP=4
SCORE_TRANS_RENDER_TITLE=简谱
SCORE_TRANS_RENDER_WIDTH=800
SCORE_TRANS_RENDER_MARGIN=20
SCORE_TRANS_RENDER_MEASURE_WIDTH=200
SCORE_TRANS_RENDER_LINE_HEIGHT=80
SCORE_TRANS_RENDER_FONT=sans-serif
SCORE_TRANS_RENDER_MIN_MEASURE_WIDTH=120
SCORE_TRANS_RENDER_MAX_MEASURE_WIDTH=400
SCORE_TRANS_RENDER_BEAT_GAP=10
SCORE_TRANS_RENDER_SHOW_BEAT_GUIDES=0
SCORE_TRANS_RENDER_SHOW_STAFF_GUIDES=0
SCORE_TRANS_RENDER_SHOW_MEASURE_NUMBERS=1

# === MIDI ===
SCORE_TRANS_MIDI_TICKS_PER_BEAT=480
SCORE_TRANS_MIDI_DEFAULT_BPM=120
SCORE_TRANS_MIDI_DEFAULT_VELOCITY=80
