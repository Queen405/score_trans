# Score Trans 环境配置
# 将此文件复制为 .env 并填入实际值

# === OCR 视觉识别 ===
SCORE_TRANS_OCR_PROVIDER=siliconflow_deepseek_ocr
SCORE_TRANS_OCR_PROVIDER_PROFILES='[{"id":"siliconflow_deepseek_ocr","label":"硅基流动 DeepSeek-OCR","provider":"openai_compatible","base_url":"https://api.siliconflow.cn/v1","model":"deepseek-ai/DeepSeek-OCR","fallback_model":"Qwen/Qwen3-VL-8B-Instruct","description":"默认 OCR 识别；结果为空时回退到 Qwen3-VL-8B。"},{"id":"siliconflow_qwen3_vl_8b","label":"硅基流动 Qwen3-VL-8B","provider":"openai_compatible","base_url":"https://api.siliconflow.cn/v1","model":"Qwen/Qwen3-VL-8B-Instruct","description":"OpenAI 兼容视觉模型，返回结构化 OCR 文本块。"},{"id":"dashscope_qwen_vl_ocr","label":"百炼 qwen-vl-ocr","provider":"dashscope","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"qwen-vl-ocr","description":"阿里云百炼 OCR 模型。"},{"id":"dashscope_qwen_vl_max","label":"百炼 qwen-vl-max","provider":"dashscope","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"qwen-vl-max","description":"阿里云百炼通用视觉模型。"}]'
SCORE_TRANS_OCR_BASE_URL=https://api.siliconflow.cn/v1
SCORE_TRANS_OCR_MODEL=deepseek-ai/DeepSeek-OCR
SCORE_TRANS_OCR_FALLBACK_MODEL=Qwen/Qwen3-VL-8B-Instruct
SCORE_TRANS_OCR_API_KEY=sk-your-siliconflow-key

# === AI 简谱转录（视觉 LLM） ===
SCORE_TRANS_AI_PROVIDER=siliconflow_qwen3_vl_8b
SCORE_TRANS_AI_PROVIDER_PROFILES='[{"id":"siliconflow_qwen3_vl_8b","label":"硅基流动 Qwen3-VL-8B","provider":"openai_compatible","base_url":"https://api.siliconflow.cn/v1","model":"Qwen/Qwen3-VL-8B-Instruct","description":"默认 AI 视觉转写模型。"},{"id":"dashscope_qwen_vl_max","label":"百炼 qwen-vl-max","provider":"dashscope","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"qwen-vl-max","description":"阿里云百炼视觉转写。"},{"id":"dashscope_qwen3_vl_plus","label":"百炼 qwen3-vl-plus","provider":"dashscope","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"qwen3-vl-plus","description":"阿里云百炼 Qwen3-VL 视觉模型。"},{"id":"xiaomi_mimo_v25","label":"小米 MiMo-V2.5","provider":"xiaomi_mimo","base_url":"https://api.xiaomimimo.com/v1","model":"mimo-v2.5","description":"MiMo 全模态视觉转写。"}]'
SCORE_TRANS_AI_BASE_URL=https://api.siliconflow.cn/v1
SCORE_TRANS_AI_MODEL=Qwen/Qwen3-VL-8B-Instruct
SCORE_TRANS_AI_API_KEY=sk-your-vision-llm-key

# === 工作台 AI 助手（百炼 OpenAI 兼容模式） ===
SCORE_TRANS_ASSISTANT_PROVIDER=dashscope_deepseek_v4_flash
SCORE_TRANS_ASSISTANT_PROVIDER_PROFILES='[{"id":"dashscope_deepseek_v4_flash","label":"百炼 DeepSeek-V4-Flash","provider":"dashscope","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"deepseek-v4-flash","description":"默认工作台对话模型。"},{"id":"dashscope_qwen_plus","label":"百炼 qwen-plus","provider":"dashscope","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"qwen-plus","description":"百炼通用对话模型。"}]'
SCORE_TRANS_ASSISTANT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SCORE_TRANS_ASSISTANT_MODEL=deepseek-v4-flash
SCORE_TRANS_ASSISTANT_API_KEY=sk-your-bailian-key

# === OMR 图像预处理 ===
SCORE_TRANS_OMR_PREPROCESS=1
SCORE_TRANS_OMR_PREPROCESS_LONG_EDGE=3600
SCORE_TRANS_OMR_PREPROCESS_BINARIZE=0
