# Score Trans 环境配置
# 将此文件复制为 .env 并填入实际值

# === API 基本配置 ===
SCORE_TRANS_API_TITLE=Score Trans
SCORE_TRANS_API_VERSION=0.1.0
SCORE_TRANS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
# 独立启动后端时必须设置至少 32 字符的随机值；Electron 每次启动会自动覆盖为随机 token。
SCORE_TRANS_API_TOKEN=replace-this-with-a-random-token-at-least-32-characters
# 仅用于明确的本地调试/测试；正常运行必须保持 0。
SCORE_TRANS_API_AUTH_DISABLED=0
# 单个上传文件上限与 multipart 请求总上限（bytes）。
SCORE_TRANS_MAX_UPLOAD_FILE_BYTES=268435456
SCORE_TRANS_MAX_UPLOAD_REQUEST_BYTES=536870912

# === 可选路径覆盖 ===
# 留空时使用应用默认工作目录和 JDK。
SCORE_TRANS_WORKDIR=
SCORE_TRANS_JAVA_HOME=

# === OCR 视觉识别 ===
SCORE_TRANS_OCR_PROVIDER=siliconflow_deepseek_ocr
SCORE_TRANS_OCR_PROVIDER_PROFILES='[{"id":"siliconflow_deepseek_ocr","label":"硅基流动 DeepSeek-OCR","provider":"openai_compatible","base_url":"https://api.siliconflow.cn/v1","model":"deepseek-ai/DeepSeek-OCR","fallback_model":"Qwen/Qwen3-VL-8B-Instruct","description":"默认 OCR 识别；结果为空时回退到 Qwen3-VL-8B。"}]'
SCORE_TRANS_OCR_BASE_URL=https://api.siliconflow.cn/v1
SCORE_TRANS_OCR_MODEL=deepseek-ai/DeepSeek-OCR
SCORE_TRANS_OCR_FALLBACK_MODEL=Qwen/Qwen3-VL-8B-Instruct
SCORE_TRANS_OCR_API_KEY=sk-your-siliconflow-key
SCORE_TRANS_OCR_TIMEOUT=60
SCORE_TRANS_OCR_MAX_TOKENS=4096
SCORE_TRANS_OCR_TEMPERATURE=0.1

# === AI 简谱转录（视觉 LLM） ===
SCORE_TRANS_AI_PROVIDER=agnes_2_5_flash
SCORE_TRANS_AI_PROVIDER_PROFILES='[{"id":"xiaomi_mimo_v25","label":"小米 MiMo-V2.5","provider":"xiaomi_mimo","base_url":"https://api.xiaomimimo.com/v1","model":"mimo-v2.5","description":"MiMo 全模态视觉转写。","max_tokens":8192},{"id":"agnes_2_5_flash","label":"Agnes 2.5 Flash","provider":"openai_compatible","base_url":"https://apihub.agnes-ai.com/v1","model":"agnes-2.5-flash","description":"Agnes 2.5 Flash 视觉转写，支持图像理解。","max_tokens":8192},{"id":"agnes_3_0_flash","label":"Agnes 3.0 Flash","provider":"openai_compatible","base_url":"https://apihub.agnes-ai.com/v1","model":"agnes-3.0-flash","description":"Agnes 3.0 Flash 视觉转写，增强工具调用与端到端执行。","max_tokens":8192},{"id":"sensenova_6_8_flash_lite","label":"商汤 SenseNova 6.8 Flash-Lite","provider":"sensenova","base_url":"https://token.sensenova.cn/v1","model":"sensenova-6.8-flash-lite","description":"轻量多模态模型，支持图像理解与 OCR。","max_tokens":8192}]'
SCORE_TRANS_AI_BASE_URL=https://apihub.agnes-ai.com/v1
SCORE_TRANS_AI_MODEL=agnes-2.5-flash
SCORE_TRANS_AI_API_KEY=sk-your-vision-llm-key
SCORE_TRANS_AI_TIMEOUT=120
SCORE_TRANS_AI_TEMPERATURE=0.3
# 输出 token 上限回退值（provider profile 的 max_tokens 优先于此变量；默认 4096）。
# 内置 profile 已显式配置 8192；仅当 profile 未配置时使用本变量。
SCORE_TRANS_AI_MAX_TOKENS=4096
# 可选：覆盖内置的 AI 转录 system prompt。
SCORE_TRANS_AI_SYSTEM_MSG=

# === 工作台 AI 助手 ===
SCORE_TRANS_ASSISTANT_PROVIDER=agnes_2_5_flash
SCORE_TRANS_ASSISTANT_PROVIDER_PROFILES='[{"id":"dashscope_deepseek_v4_flash","label":"百炼 DeepSeek-V4-Flash","provider":"dashscope","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"deepseek-v4-flash","description":"默认工作台对话模型。","max_tokens":8192},{"id":"agnes_2_5_flash","label":"Agnes 2.5 Flash","provider":"agnes","base_url":"https://apihub.agnes-ai.com/v1","model":"agnes-2.5-flash","description":"Agnes 2.5 Flash 助手，适合智能体工作流。","max_tokens":8192},{"id":"agnes_3_0_flash","label":"Agnes 3.0 Flash","provider":"agnes","base_url":"https://apihub.agnes-ai.com/v1","model":"agnes-3.0-flash","description":"Agnes 3.0 Flash 助手，强化智能体任务与可信交付。","max_tokens":8192},{"id":"sensenova_deepseek_v4_flash","label":"商汤 DeepSeek-V4-Flash","provider":"sensenova","base_url":"https://token.sensenova.cn/v1","model":"deepseek-v4-flash","description":"DeepSeek-V4-Flash，支持思考模式切换。","max_tokens":8192}]'
SCORE_TRANS_ASSISTANT_BASE_URL=https://apihub.agnes-ai.com/v1
SCORE_TRANS_ASSISTANT_MODEL=agnes-2.5-flash
# 输出 token 上限回退值（provider profile 的 max_tokens 优先于此变量；默认 4096）。
SCORE_TRANS_ASSISTANT_MAX_TOKENS=4096
SCORE_TRANS_ASSISTANT_API_KEY=sk-your-bailian-key

# === PDF ===
SCORE_TRANS_PDF_RENDER_DPI=300
SCORE_TRANS_UPLOAD_PDF_DPI=300

# === Audiveris / Java OMR ===
# 可选：限制或强制 Audiveris 处理步骤。可用步骤：
# LOAD, BINARY, SCALE, GRID, HEADERS, STEM_SEEDS, BEAMS, LEDGERS, HEADS, STEMS,
# REDUCTION, CUE_BEAMS, TEXTS (compatibility no-op), MEASURES, CHORDS, CURVES, SYMBOLS,
# LINKS, RHYTHMS, PAGE
SCORE_TRANS_AUDIVERIS_STEP=
SCORE_TRANS_AUDIVERIS_FORCE=0
SCORE_TRANS_AUDIVERIS_SAVE=0
SCORE_TRANS_AUDIVERIS_SWAP=0
SCORE_TRANS_AUDIVERIS_TRANSCRIBE=0
SCORE_TRANS_AUDIVERIS_SHEETS=
# 用分号分隔多个 Audiveris -constant key=value
SCORE_TRANS_AUDIVERIS_CONSTANTS=
# 高级兜底：直接追加 Audiveris CLI 参数，例如：-run some.Class
SCORE_TRANS_AUDIVERIS_EXTRA_ARGS=
# Audiveris JVM 最大堆内存，可选：1g / 2g / 3g / 4g（默认 3g）
# 21MP 高分辨率曲谱约需 1-2g；启动时若内存溢出崩溃，调小此值
SCORE_TRANS_AUDIVERIS_MAX_HEAP=3g
# Audiveris 最大像素上限（图片宽×高），默认 4500000；0=不按此上限缩放
# PNG/JPG/WEBP 超过上限 95% 时会等比缩放到上限 95% 后再交给 Audiveris
SCORE_TRANS_AUDIVERIS_MAX_PIXEL_COUNT=4500000
# 自动放大低分辨率图片：1=开启（默认），0=关闭
# 仅对栅格图（JPG/PNG/WEBP）生效；PDF 直接输入不受影响，PDF 拆出的 PNG 会处理
SCORE_TRANS_AUDIVERIS_AUTO_UPSCALE=1
# 预防性放大的目标长边像素数（默认 2500）
# 图片长边低于此值时按 LANCZOS 放大；最终像素数受 MAX_PIXEL_COUNT 的 95% 预算封顶
SCORE_TRANS_AUDIVERIS_MIN_IMAGE_EDGE=2500

# === MIDI ===
SCORE_TRANS_MIDI_TICKS_PER_BEAT=480
SCORE_TRANS_MIDI_DEFAULT_VELOCITY=80
