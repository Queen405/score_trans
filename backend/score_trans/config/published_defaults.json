{
  "version": 1,
  "backend": {
    "audiveris_max_heap": "2g",
    "audiveris_max_pixel_count": "20000000",
    "audiveris_auto_upscale": "1",
    "audiveris_min_image_edge": "2500",
    "target_key": "C",
    "midi_tempo": "auto",
    "accidental_mode": "auto",
    "measure_number_mode": "all",
    "show_measure_numbers": "1",
    "jianpu_syntax_highlight": "0",
    "jianpu_measure_duration_check": "0",
    "jianpu_content_scale_percent": "67",
    "jianpu_system_gap_percent": "92",
    "jianpu_short_note_gap_percent": "90",
    "enable_omr_ocr": "1",
    "output_dir": ""
  },
  "providers": {
    "ocr": {
      "provider": "siliconflow_deepseek_ocr",
      "base_url": "https://api.siliconflow.cn/v1",
      "model": "deepseek-ai/DeepSeek-OCR",
      "fallback_model": "Qwen/Qwen3-VL-8B-Instruct"
    },
    "ai": {
      "provider": "xiaomi_mimo_v25",
      "base_url": "https://api.xiaomimimo.com/v1",
      "model": "mimo-v2.5"
    },
    "assistant": {
      "provider": "dashscope_deepseek_v4_flash",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "deepseek-v4-flash"
    }
  }
}
