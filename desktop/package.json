{
  "name": "score-trans-desktop",
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "description": "Score Trans - 五线谱/简谱互转桌面应用",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint --config eslint.config.mjs src/",
    "typecheck": "vue-tsc --noEmit",
    "test:utils": "node --test scripts/test-jianpu-page-sections.mjs scripts/test-text-anchor-tracking.mjs",
    "generate:api-types": "node scripts/export-openapi.mjs && openapi-typescript ../build/openapi.json -o src/renderer/src/models/openapi.ts --export-type --alphabetize --default-non-nullable false",
    "check:api-types": "node scripts/export-openapi.mjs && openapi-typescript ../build/openapi.json -o src/renderer/src/models/openapi.ts --export-type --alphabetize --default-non-nullable false --check"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "@vicons/ionicons5": "^0.12.0",
    "date-fns": "^3.6.0",
    "naive-ui": "^2.40.3",
    "pinia": "^2.2.8",
    "tone": "^15.1.22",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.8"
  }
}
